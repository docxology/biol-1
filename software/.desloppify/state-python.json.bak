        ],
        "evidence": [
          "validate_outputs(course_path: str, formats: List[str] = None, ...) \u2014 annotation is wrong",
          "generate_validation_report(..., formats: List[str] = None, ...) \u2014 annotation is wrong",
          "_validate_module_outputs(module_path: Path, formats: List[str] = None) \u2014 annotation is wrong",
          "All three internally handle None with 'if formats is None' or 'formats or DEFAULT_REQUIRED_FORMATS' \u2014 confirming None is intended"
        ],
