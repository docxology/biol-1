    "review::.::holistic::authorization_consistency::ac-01::0c3d92b2": {
      "id": "review::.::holistic::authorization_consistency::ac-01::0c3d92b2",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "canvas_integration _upload_file_to_canvas() uses requests.post() directly for the upload step, bypassing the make_canvas_request() wrapper and its rate-limiting protection",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "src/canvas_integration/main.py"
        ],
        "evidence": [
          "Line 213: 'upload_response = requests.post(upload_url, files=files)' \u2014 direct requests.post(), not make_canvas_request()",
          "make_canvas_request() in utils.py applies time.sleep(config.RATE_LIMIT_DELAY) before every request \u2014 this is skipped for the file upload step",
          "The upload URL is an external Canvas-provided URL, so the Bearer header from make_canvas_request() is not needed here (correct), but rate-limiting should still apply"
        ],
        "suggestion": "Add time.sleep(config.RATE_LIMIT_DELAY) before line 213, or extract a _rate_limited_post() helper that applies only the rate-limiting concern without injecting the Authorization header (which is not appropriate for the pre-signed upload URL).",
        "reasoning": ""
      },
      "status": "open",
      "note": null,
