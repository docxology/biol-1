# Fork template — copy to config.yaml and replace TODO-OWNER values.
# Derived from this repository's own manuscript/config.yaml; structural
# fields mirror the live config. See manuscript/AGENTS.md for the token protocol.

# Template-format manuscript configuration for cr-bio.
# Scaffolded from the project README/AGENTS context; update before publication.

paper:
  title: "Biology at College of the Redwoods: Course Production System"
  subtitle: "A modular manuscript scaffold for reproducible course-material generation"
  version: "0.1.0"
  date: ""

authors:
  - name: "TODO-OWNER: author name"
    orcid: ""
    email: "TODO-OWNER: author email"
    affiliation: "TODO-OWNER: affiliation"
    corresponding: true

publication:
  doi: ""
  version_doi: ""
  version_record: ""
  github_repository: ""
  year: "2026"
  transmission_bookends:
    enabled: false
    max_prior_releases: 5
    show_steganography: false

keywords:
  - "biology education"
  - "course materials"
  - "curriculum generation"
  - "College of the Redwoods"
  - "reproducible publishing"

metadata:
  license: "TBD"
  language: "en"

manuscript_dir: "manuscript"

render:
  formats:
    pdf: true
    html: true
    slides: true
    docx: false
    epub: false

bibliography:
  references_path: "manuscript/references.bib"
  fail_on_missing: true
  fail_on_unused: false
